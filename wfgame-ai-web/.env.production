NODE_ENV = production
# 线上环境平台打包路径
VITE_PUBLIC_PATH = /static/dist/

# 线上环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"

# 是否在打包时使用cdn替换本地库 替换 true 不替换 false
VITE_CDN = false

# 是否启用gzip压缩或brotli压缩（分两种情况，删除原始文件和不删除原始文件）
# 压缩时不删除原始文件的配置：gzip、brotli、both（同时开启 gzip 与 brotli 压缩）、none（不开启压缩，默认）
# 压缩时删除原始文件的配置：gzip-clear、brotli-clear、both-clear（同时开启 gzip 与 brotli 压缩）、none（不开启压缩，默认）
VITE_COMPRESSION = "none"

# 后端服务地址
VITE_BACKEND_HOST = "http://172.20.19.101:8000"

# 媒体资源地址
VITE_MEDIA_HOST = "http://172.20.19.101:8000"

# MINIO 地址
VITE_MINIO_HOST = "http://172.28.133.200:19000"

VITE_SSO_HOST = "https://autoapi.wanfeng-inc.com"

# zstd 压缩算法分片大小配置
VITE_ZSTD_CHUNK_KB = 2 * 1024
# zstd 解压分片阈值配置
VITE_ZSTD_THRESHOLD_KB = 10 * 1024

# wss链接地址
VITE_WSS_URL = "172.20.19.101"
VITE_WSS_PORT = 13838
